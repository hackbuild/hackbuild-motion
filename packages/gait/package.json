{
  "name": "@hackbuild/gait",
  "version": "0.1.0",
  "description": "Procedural legged locomotion: Froude gait choice, leg oscillators, footfall tables, posture springs, tail and ear secondary motion. Rust core in wasm.",
  "type": "module",
  "license": "MIT",
  "author": "Moheeb Zara <hackbuildvideo@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hackbuild/hackbuild-motion.git",
    "directory": "packages/gait"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./three": {
      "types": "./dist/three.d.ts",
      "import": "./dist/three.js"
    },
    "./inline": {
      "types": "./dist/wasm/inline.d.ts",
      "import": "./dist/wasm/inline.js"
    },
    "./wasm": "./dist/wasm/gait_bg.wasm",
    "./iife": "./dist/gait.iife.js"
  },
  "unpkg": "dist/gait.iife.js",
  "jsdelivr": "dist/gait.iife.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "how.ts"
  ],
  "scripts": {
    "build": "node ../../tools/build-package.mjs gait"
  },
  "peerDependencies": {
    "three": ">=0.186.1"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  }
}
