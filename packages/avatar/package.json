{
  "name": "@hackbuild/avatar",
  "version": "0.1.2",
  "description": "Load VRM, Mixamo, UAL, generic GLB and FBX characters into the normalized humanoid space, with material and texture repair, wardrobe slots, expressions and first person head hiding.",
  "type": "module",
  "license": "MIT",
  "author": "Moheeb Zara <hackbuildvideo@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hackbuild/hackbuild-motion.git",
    "directory": "packages/avatar"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./three": {
      "types": "./dist/three.d.ts",
      "import": "./dist/three.js"
    },
    "./vrm": {
      "types": "./dist/vrm.d.ts",
      "import": "./dist/vrm.js"
    },
    "./mmd": {
      "types": "./dist/mmd.d.ts",
      "import": "./dist/mmd.js"
    },
    "./iife": "./dist/avatar.iife.js"
  },
  "unpkg": "dist/avatar.iife.js",
  "jsdelivr": "dist/avatar.iife.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "how.ts"
  ],
  "scripts": {
    "build": "node ../../tools/build-package.mjs avatar"
  },
  "dependencies": {
    "@hackbuild/rig": "0.1.1"
  },
  "peerDependencies": {
    "@moeru/three-mmd": ">=0.2.0-beta.3",
    "@pixiv/three-vrm": ">=3.5.5",
    "three": ">=0.186.1"
  },
  "peerDependenciesMeta": {
    "@moeru/three-mmd": {
      "optional": true
    },
    "@pixiv/three-vrm": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  }
}
