{
  "name": "@hackbuild/bake",
  "version": "0.1.1",
  "description": "GLB optimize with texture hooks, clip bake into compact packs with error, seam and contact reports, and an asset lock file with licence and SHA-256. Rust core in wasm, plus a native command line tool.",
  "type": "module",
  "license": "MIT",
  "author": "Moheeb Zara <hackbuildvideo@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hackbuild/hackbuild-motion.git",
    "directory": "packages/bake"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./inline": {
      "types": "./dist/wasm/inline.d.ts",
      "import": "./dist/wasm/inline.js"
    },
    "./wasm": "./dist/wasm/bake_bg.wasm",
    "./iife": "./dist/bake.iife.js"
  },
  "unpkg": "dist/bake.iife.js",
  "jsdelivr": "dist/bake.iife.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "how.ts"
  ],
  "scripts": {
    "build": "node ../../tools/build-package.mjs bake"
  }
}
