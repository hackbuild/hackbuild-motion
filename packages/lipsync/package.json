{
  "name": "@hackbuild/lipsync",
  "version": "0.1.1",
  "description": "Viseme driver: timed words, phonemes or visemes from a TTS engine with coarticulation, or the audio level when no timings exist, out to Oculus visemes, VRM vowels or ARKit blendshapes.",
  "type": "module",
  "license": "MIT",
  "author": "Moheeb Zara <hackbuildvideo@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hackbuild/hackbuild-motion.git",
    "directory": "packages/lipsync"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bellows": {
      "types": "./dist/bellows.d.ts",
      "import": "./dist/bellows.js"
    },
    "./articulatory": {
      "types": "./dist/articulatory.d.ts",
      "import": "./dist/articulatory.js"
    },
    "./iife": "./dist/lipsync.iife.js"
  },
  "unpkg": "dist/lipsync.iife.js",
  "jsdelivr": "dist/lipsync.iife.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "how.ts"
  ],
  "scripts": {
    "build": "node ../../tools/build-package.mjs lipsync"
  },
  "dependencies": {
    "@hackbuild/rig": "0.1.1"
  },
  "peerDependencies": {
    "bellows-voice": "0.8.0",
    "bellowsjs": "0.5.0"
  },
  "peerDependenciesMeta": {
    "bellows-voice": {
      "optional": true
    },
    "bellowsjs": {
      "optional": true
    }
  }
}
