{
  "name": "@hackbuild/motion-match",
  "version": "0.1.2",
  "description": "Classic motion matching over a clip database: normalized trajectory and foot features, bounding box search, inertialized transitions. Rust core in wasm.",
  "type": "module",
  "license": "MIT",
  "author": "Moheeb Zara <hackbuildvideo@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hackbuild/hackbuild-motion.git",
    "directory": "packages/motion-match"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./inline": {
      "types": "./dist/wasm/inline.d.ts",
      "import": "./dist/wasm/inline.js"
    },
    "./wasm": "./dist/wasm/motion_match_bg.wasm",
    "./iife": "./dist/motion-match.iife.js"
  },
  "unpkg": "dist/motion-match.iife.js",
  "jsdelivr": "dist/motion-match.iife.js",
  "files": [
    "dist",
    "README.md",
    "llms.md",
    "LICENSE",
    "how.ts"
  ],
  "scripts": {
    "build": "node ../../tools/build-package.mjs motion-match"
  }
}
