{
  "name": "@hackbuild/retarget",
  "version": "0.1.0",
  "description": "Humanoid motion interchange format, clip retargeting between any rigs, BVH and VMD readers, motion analysis that tags clips. Rust core in wasm.",
  "type": "module",
  "license": "MIT",
  "author": "Moheeb Zara <hackbuildvideo@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hackbuild/hackbuild-motion.git",
    "directory": "packages/retarget"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./three": {
      "types": "./dist/three.d.ts",
      "import": "./dist/three.js"
    },
    "./inline": {
      "types": "./dist/wasm/inline.d.ts",
      "import": "./dist/wasm/inline.js"
    },
    "./wasm": "./dist/wasm/retarget_bg.wasm",
    "./iife": "./dist/retarget.iife.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../tools/build-package.mjs retarget"
  },
  "dependencies": {
    "@hackbuild/rig": "0.1.0"
  },
  "peerDependencies": {
    "three": ">=0.186.1"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  }
}
